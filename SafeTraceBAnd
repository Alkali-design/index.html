<script>
  // subtle vitals tick — purely cosmetic, respects reduced-motion via CSS
  const hr = document.querySelector('.readout .val');
  let base = 78;
  setInterval(() => {
    base = 76 + Math.floor(Math.random() * 5);
    if (hr) hr.textContent = base;
  }, 2600);

  // reveal steps on scroll
  const steps = document.querySelectorAll('.step');
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in-view'); });
  }, { threshold: 0.2 });
  steps.forEach(s => io.observe(s));
