<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Safe Trace Band — A Life-Sign Wearable for School Girl Safety</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#15101F;
    --ink-2:#1E1730;
    --ink-3:#2A2042;
    --paper:#F5F2F9;
    --paper-2:#E9E2F1;
    --purple:#8A4FE0;
    --purple-deep:#5B2C99;
    --purple-bright:#B07EF0;
    --life:#39B54A;
    --life-soft:#2C8F3A;
    --amber:#F5A623;
    --alert:#E1483C;
    --steel:#A296BE;
    --steel-2:#635979;
    --line: rgba(245,242,249,0.12);
    --line-dark: rgba(21,16,31,0.10);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'IBM Plex Sans', sans-serif;
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }
  .mono{font-family:'IBM Plex Mono', monospace;}
  h1,h2,h3{font-family:'Space Grotesk', sans-serif; letter-spacing:-0.01em;}
  a{color:inherit;}
  img,svg{display:block; max-width:100%;}
  .wrap{max-width:1160px; margin:0 auto; padding:0 32px;}
  @media (max-width:640px){ .wrap{padding:0 20px;} }

  .eyebrow{
    font-family:'IBM Plex Mono', monospace;
    font-size:12.5px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    display:inline-flex;
    align-items:center;
    gap:9px;
    color:var(--purple-bright);
  }
  .eyebrow::before{
    content:"";
    width:7px; height:7px; border-radius:50%;
    background:var(--purple-bright);
    box-shadow:0 0 0 0 rgba(138,79,224,0.6);
    animation:pulseDot 2.2s ease-out infinite;
  }
  @keyframes pulseDot{
    0%{box-shadow:0 0 0 0 rgba(138,79,224,0.55);}
    70%{box-shadow:0 0 0 8px rgba(138,79,224,0);}
    100%{box-shadow:0 0 0 0 rgba(138,79,224,0);}
  }

  /* NAV */
  nav{
    position:sticky; top:0; z-index:50;
    background:rgba(21,16,31,0.92);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  nav .wrap{display:flex; align-items:center; justify-content:space-between; height:72px;}
  .brand{display:flex; align-items:center; gap:10px; color:var(--paper); font-family:'Space Grotesk'; font-weight:600; font-size:17px;}
  .brand-mark{width:26px; height:26px;}
  .navlinks{display:flex; gap:32px; font-size:14.5px; color:var(--steel);}
  .navlinks a{text-decoration:none; transition:color .2s;}
  .navlinks a:hover{color:var(--paper);}
  .nav-cta{
    font-size:13.5px; font-weight:600; color:var(--paper); background:var(--purple);
    padding:9px 18px; border-radius:3px; text-decoration:none; letter-spacing:0.01em;
  }
  @media (max-width:800px){ .navlinks{display:none;} }

  /* HERO */
  .hero{background:radial-gradient(ellipse 900px 600px at 78% 15%, rgba(138,79,224,0.22), transparent 60%), var(--ink); color:var(--paper); position:relative; overflow:hidden; padding:88px 0 0;}
  .hero-grid{display:grid; grid-template-columns:1.05fr 0.95fr; gap:56px; align-items:center; padding-bottom:70px;}
  @media (max-width:920px){ .hero-grid{grid-template-columns:1fr; padding-bottom:40px;} }
  .hero h1{font-size:clamp(38px,5.2vw,64px); font-weight:700; line-height:1.04; margin:22px 0 22px; color:var(--paper);}
  .hero h1 em{font-style:normal; color:var(--purple-bright);}
  .hero p.lede{font-size:18px; color:var(--steel); max-width:480px; margin-bottom:34px;}
  .btn-row{display:flex; gap:14px; flex-wrap:wrap;}
  .btn{
    padding:13px 24px; border-radius:3px; font-size:14.5px; font-weight:600;
    text-decoration:none; display:inline-flex; align-items:center; gap:8px;
    transition:transform .15s ease, background .2s ease;
  }
  .btn:hover{transform:translateY(-1px);}
  .btn-primary{background:var(--purple); color:var(--paper);}
  .btn-primary:hover{background:var(--purple-bright); color:var(--ink);}
  .btn-ghost{background:transparent; color:var(--paper); border:1px solid var(--line);}
  .btn-ghost:hover{border-color:var(--paper);}

  /* DEVICE CARD (hero product photo) */
  .device-card{
    background:var(--ink-2);
    border:1px solid var(--line);
    border-radius:10px;
    overflow:hidden;
    position:relative;
  }
  .device-card::before{
    content:"";
    position:absolute; inset:-40% -40% auto -40%; height:140%;
    background:radial-gradient(ellipse at center, rgba(138,79,224,0.35), transparent 65%);
    z-index:0; pointer-events:none;
  }
  .device-photo{
    position:relative; z-index:1;
    background:var(--paper);
    padding:22px 22px 10px;
  }
  .device-photo img{width:100%; height:auto; border-radius:4px;}
  .device-info{
    position:relative; z-index:1;
    padding:18px 22px 20px;
  }
  .vitals-head{display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;}
  .vitals-title{font-family:'IBM Plex Mono'; font-size:11.5px; letter-spacing:0.1em; color:var(--steel); text-transform:uppercase;}
  .vitals-live{font-family:'IBM Plex Mono'; font-size:11px; color:var(--life); display:flex; align-items:center; gap:6px;}
  .vitals-live::before{content:""; width:6px; height:6px; border-radius:50%; background:var(--life); animation:pulseDot 2.2s ease-out infinite;}
  .readouts{display:grid; grid-template-columns:repeat(3,1fr); gap:10px;}
  .readout{border-left:2px solid var(--line); padding-left:10px;}
  .readout .val{font-family:'IBM Plex Mono'; font-size:19px; font-weight:500; color:var(--paper);}
  .readout .val.amber{color:var(--amber);}
  .readout .lab{font-family:'IBM Plex Mono'; font-size:9.5px; letter-spacing:0.08em; color:var(--steel); text-transform:uppercase; margin-top:2px;}
  .vitals-foot{margin-top:16px; padding-top:14px; border-top:1px solid var(--line); font-family:'IBM Plex Mono'; font-size:11px; color:var(--steel); display:flex; justify-content:space-between;}

  /* thin waveform divider between sections */
  .wave-divider{width:100%; height:34px; overflow:hidden;}
  .wave-divider svg{width:100%; height:100%;}

  /* HARDWARE SHOWCASE */
  .hardware{background:var(--paper);}
  .hardware-card{
    margin-top:44px; background:var(--ink); border-radius:12px; overflow:hidden;
    display:grid; grid-template-columns:1fr; position:relative;
  }
  .hardware-card::before{
    content:""; position:absolute; inset:0;
    background:radial-gradient(ellipse 700px 400px at 20% 10%, rgba(138,79,224,0.28), transparent 60%);
    pointer-events:none;
  }
  .hardware-photo-wrap{position:relative; z-index:1; background:var(--paper); margin:18px; border-radius:8px; overflow:hidden;}
  .hardware-photo-wrap img{width:100%; height:auto; display:block;}
  .hardware-legend{
    position:relative; z-index:1; padding:8px 30px 34px;
    display:flex; flex-wrap:wrap; gap:28px; color:var(--steel); font-size:13.5px;
  }
  .hardware-legend .item{display:flex; align-items:center; gap:8px;}
  .hardware-legend .dot{width:7px; height:7px; border-radius:50%; background:var(--purple-bright); flex:none;}

  section{padding:86px 0;}
  .section-tag{margin-bottom:14px;}
  h2.section-title{font-size:clamp(28px,3.6vw,40px); font-weight:600; max-width:640px; line-height:1.12; margin-bottom:18px;}
  .section-sub{font-size:16.5px; color:var(--steel-2); max-width:600px;}

  /* PROBLEM */
  .problem{background:var(--paper);}
  .problem-grid{display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:start; margin-top:44px;}
  @media (max-width:860px){ .problem-grid{grid-template-columns:1fr; gap:36px;} }
  .problem-text p{color:var(--steel-2); font-size:16px; margin-bottom:16px;}
  .stat-block{display:flex; flex-direction:column; gap:22px;}
  .stat{border-top:1px solid var(--line-dark); padding-top:14px;}
  .stat .n{font-family:'Space Grotesk'; font-size:34px; font-weight:700; color:var(--purple-deep);}
  .stat .d{font-size:13.5px; color:var(--steel-2); margin-top:2px;}

  /* HOW IT WORKS */
  .how{background:var(--ink); color:var(--paper);}
  .how h2.section-title{color:var(--paper);}
  .how .section-sub{color:var(--steel);}
  .steps{margin-top:52px; display:flex; flex-direction:column;}
  .step{
    display:grid; grid-template-columns:64px 1fr; gap:22px;
    padding:26px 0; border-top:1px solid var(--line);
    opacity:0; transform:translateY(14px);
    transition:opacity .6s ease, transform .6s ease;
  }
  .step.in-view{opacity:1; transform:translateY(0);}
  .step:last-child{border-bottom:1px solid var(--line);}
  .step-num{font-family:'IBM Plex Mono'; font-size:13px; color:var(--purple-bright); padding-top:3px;}
  .step-body h3{font-size:19px; font-weight:600; margin-bottom:6px; color:var(--paper);}
  .step-body p{color:var(--steel); font-size:15px; max-width:600px;}

  /* FEATURES */
  .features{background:var(--paper);}
  .feat-grid{margin-top:46px; display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--line-dark); border:1px solid var(--line-dark);}
  @media (max-width:820px){ .feat-grid{grid-template-columns:1fr 1fr;} }
  @media (max-width:560px){ .feat-grid{grid-template-columns:1fr;} }
  .feat{background:var(--paper); padding:30px 26px; min-height:168px;}
  .feat .fico{width:30px; height:30px; margin-bottom:16px;}
  .feat h3{font-size:16.5px; font-weight:600; margin-bottom:8px;}
  .feat p{font-size:14px; color:var(--steel-2);}

  /* PRIVACY BAND */
  .privacy{background:var(--ink-3); color:var(--paper); padding:96px 0; text-align:center;}
  .privacy .wrap{max-width:760px;}
  .privacy .eyebrow{justify-content:center; margin-bottom:22px;}
  .privacy blockquote{font-family:'Space Grotesk'; font-size:clamp(24px,3.4vw,34px); font-weight:600; line-height:1.28;}
  .privacy blockquote span{color:var(--life);}
  .privacy .note{margin-top:26px; color:var(--steel); font-size:14.5px;}

  /* BUILT BY */
  .team{background:var(--paper); text-align:center;}
  .team .wrap{max-width:720px;}
  .team-badge{
    display:inline-flex; align-items:center; gap:10px; margin-bottom:24px;
    font-family:'IBM Plex Mono'; font-size:12px; letter-spacing:0.08em; text-transform:uppercase;
    color:var(--purple-deep); border:1px solid var(--purple-deep); padding:8px 16px; border-radius:20px;
  }
  .team h2{font-size:clamp(24px,3.2vw,32px); margin-bottom:16px;}
  .team p{color:var(--steel-2); font-size:16px; max-width:560px; margin:0 auto;}
  .team-names{margin-top:30px; font-size:14px; color:var(--steel-2);}
  .team-names strong{color:var(--ink); font-weight:600;}

  /* CTA / FOOTER */
  footer{background:var(--ink); color:var(--paper);}
  .cta-block{padding:76px 0 56px; border-bottom:1px solid var(--line); display:flex; justify-content:space-between; align-items:flex-end; gap:30px; flex-wrap:wrap;}
  .cta-block h2{font-size:clamp(26px,3.4vw,36px); max-width:480px; color:var(--paper); margin-bottom:8px;}
  .cta-block p{color:var(--steel); max-width:420px; font-size:15px;}
  .foot-bottom{padding:26px 0; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px; font-size:13px; color:var(--steel);}
  .foot-links{display:flex; gap:22px;}
  .foot-links a{text-decoration:none; color:var(--steel); transition:color .2s;}
  .foot-links a:hover{color:var(--paper);}

  ::selection{background:var(--purple); color:var(--paper);}
  :focus-visible{outline:2px solid var(--purple); outline-offset:3px;}

  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important;}
    #ecgpath{stroke-dashoffset:0;}
  }
</style>
</head>
<body>

<nav>
  <div class="wrap">
    <div class="brand">
      <svg class="brand-mark" viewBox="0 0 26 26" fill="none">
        <circle cx="13" cy="13" r="12" stroke="#39B54A" stroke-width="1.6"/>
        <path d="M4 13h4l2-5 3 10 2-7 2 4h5" stroke="#39B54A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      </svg>
      Safe Trace Band
    </div>
    <div class="navlinks">
      <a href="#problem">The Gap</a>
      <a href="#how">How It Works</a>
      <a href="#hardware">Hardware</a>
      <a href="#features">Features</a>
